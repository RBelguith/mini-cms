{
  "info": {
    "_postman_id": "a1f2d8e4-9b6c-4f0a-8d47-5c1e7a2b9f03",
    "name": "Mini-CMS API",
    "description": "Collection de démonstration de l'API Mini-CMS. Le jeton est obtenu par la requête Connexion puis stocké dans la variable de collection `token` : aucun secret n'est exporté.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Connexion",
      "id": "b2c3d4e5-6f70-4819-9a2b-3c4d5e6f7081",
      "auth": {
        "type": "noauth"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "    pm.collectionVariables.set('token', pm.response.json().token);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "login"
          ]
        },
        "description": "Obtient un jeton Sanctum et le stocke automatiquement dans la variable de collection `token`."
      },
      "response": []
    },
    {
      "name": "Articles",
      "id": "c3d4e5f6-7081-492a-8b3c-4d5e6f708192",
      "auth": {
        "type": "noauth"
      },
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/posts?per_page=2",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "posts"
          ],
          "query": [
            {
              "key": "per_page",
              "value": "2"
            }
          ]
        },
        "description": "Lecture publique des deux premiers articles publiés."
      },
      "response": []
    },
    {
      "name": "Créer un article",
      "id": "d4e5f6a7-8192-4a3b-9c4d-5e6f708192a3",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Articleenvoyé par Postman\",\n  \"slug\": \"article-envoye-par-postman-{{$randomInt}}\",\n  \"excerpt\": \"Créé avec un jeton Sanctum.\",\n  \"body\": \"Le contenu complet de cet article, envoyé en JSON depuis Postman.\",\n  \"is_published\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/posts",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "posts"
          ]
        },
        "description": "Écriture protégée : hérite du Bearer {{token}} de la collection. Changez le slug entre deux envois."
      },
      "response": []
    },
    {
      "name": "Déconnexion",
      "id": "e5f6a7b8-92a3-4b4c-ad5e-6f708192a3b4",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/logout",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "logout"
          ]
        },
        "description": "Révoque le jeton courant ; hérite du Bearer {{token}} de la collection."
      },
      "response": []
    }
  ]
}
